# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 실행 환경마다 다른 설정.
# ROI 좌표는 해상도/UI 배율에 묶여 있어 남의 환경에서 의미가 없다.
# roi_picker.py로 각자 잡는다.
app_config.json

# 캡처 이미지는 올린다 (소유자 결정).
# 다만 게임 스크린샷에는 캐릭터명, 길드/파티 채팅, 다른 플레이어
# 닉네임이 그대로 남는다. 전체 화면 캡처라면 게임 밖 내용까지 들어간다.
# 새 캡처를 넣을 때 그 점을 한 번씩 확인할 것.
#
# 분석하다 만든 임시 이미지만 제외한다. 언제든 다시 만들 수 있고
# 자료가 아니라 그때그때의 확인용이다.
captures/_*.png

# 렌더 확인 산출물
render_check.png

# 원본 전달 아카이브 (소스와 중복)
loa_buff.zip

# 작업 중 만든 백업
*.bak
